{
  "name": "chalkboard",
  "version": "0.1.0",
  "private": true,
  "license": "Unlicense",
  "description": "A local-first collaborative mathematics workspace",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24.0.0"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@>=4.0.0 <5.0.9": "5.0.9",
      "esbuild@>=0.27.3 <0.28.1": "0.28.1",
      "fast-uri@>=3.0.0 <3.1.5": "3.1.5",
      "fast-uri@>=4.0.0 <4.1.2": "4.1.2",
      "nanoid@<3.3.18": "3.3.18"
    },
    "patchedDependencies": {
      "mathlive@0.110.0": "patches/mathlive@0.110.0.patch"
    }
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --parallel --filter @chalkboard/web --filter @chalkboard/server dev",
    "db:migrate": "pnpm --filter @chalkboard/server db:migrate",
    "db:seed-demo": "pnpm --filter @chalkboard/server db:seed-demo",
    "format": "node scripts/format.mjs --write",
    "format:check": "node scripts/format.mjs",
    "lint": "eslint . --max-warnings 0",
    "playwright": "node scripts/run-playwright.mjs",
    "test": "pnpm -r --if-present test && pnpm test:operations",
    "test:e2e": "pnpm playwright test",
    "test:e2e:cloud": "pnpm playwright test --config playwright.cloud.config.ts",
    "test:e2e:math-fuzz": "pnpm playwright test tests/equation-fuzz.spec.ts --project=chromium",
    "test:integration": "pnpm --filter @chalkboard/server test:integration",
    "test:operations": "node --test deploy/*.test.mjs",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@chalkboard/shared": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@types/node": "^24.13.3",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "lib0": "^0.2.117",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0"
  }
}
