# PostgreSQL
POSTGRES_DB=chalkboard
POSTGRES_USER=chalkboard
POSTGRES_PASSWORD=chalkboard
# 5433 avoids conflicts with a host PostgreSQL installation.
POSTGRES_PORT=5433
POSTGRES_DATA_PATH=./data/development-postgres
DATABASE_URL=postgresql://chalkboard:chalkboard@127.0.0.1:5433/chalkboard

# Applications
# Local/test development permits the hard maximum. Production Compose starts
# with a 10-account canary and can never exceed 250.
ACCOUNT_REGISTRATION_LIMIT=250
# Deployed builds expose their source commit and application version in diagnostics.
CHALKBOARD_COMMIT=development
CHALKBOARD_VERSION=0.1.0
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
# Set this to the externally visible HTTPS origin in production.
PUBLIC_ORIGIN=http://localhost:5173
# Production email delivery requires this complete group. The provider API key
# is read from a mounted file, never from here; codes and destination addresses
# are never logged. Development instead captures only @chalkboard.test messages
# in memory at /development/emails and makes no provider request.
# Production Compose defaults to a 10/day and 100/month canary. The immutable
# application maxima are 100/day and 3000/rolling 30 days, matching the free
# provider plan's monthly allowance.
EMAIL_DAILY_SEND_LIMIT=100
EMAIL_MONTHLY_SEND_LIMIT=3000
# EMAIL_FROM=Chalkboard <support@chalkboard.space>
# EMAIL_REPLY_TO=support@chalkboard.space
# Public browser configuration; this is not a secret.
# TURNSTILE_SITE_KEY=public-site-key
# Production private material is read from strict owner-only mounted files,
# never from environment values. Do not put file contents in this file.
ADMISSION_HMAC_KEY_FILE=/run/secrets/admission-hmac-key
ADMISSION_HMAC_KEY_GENERATION_FILE=/run/secrets/admission-hmac-key-generation
TURNSTILE_SECRET_FILE=/run/secrets/turnstile-secret
RESEND_API_KEY_FILE=/run/secrets/resend-api-key
RESEND_WEBHOOK_SECRET_FILE=/run/secrets/resend-webhook-secret
SHUTDOWN_TIMEOUT_MS=30000
# Count the proxies in front of Fastify. Development has none, so 1. Production
# serves through a TLS terminator and nginx, so it is always 2.
TRUST_PROXY_HOPS=1
# Bound in-flight REST API requests process-wide.
API_REQUEST_CONCURRENCY_LIMIT=128
# Bound in-flight image upload bodies process-wide.
ASSET_UPLOAD_CONCURRENCY_LIMIT=4
# Bound CPU-intensive password hashing and verification work process-wide.
PASSWORD_WORK_CONCURRENCY_LIMIT=4
PASSWORD_WORK_PENDING_LIMIT=16
# Compact active Yjs rooms after this many durable updates.
YJS_COMPACTION_UPDATE_THRESHOLD=100
# Bound individual updates, reconstructed rooms, and compaction work.
YJS_MAX_UPDATE_BYTES=900000
YJS_MAX_DOCUMENT_BYTES=5242880
YJS_MAX_LOADED_UPDATES=1000
YJS_MAX_LOADED_BYTES=33554432
YJS_MAX_CONCURRENT_COMPACTIONS=4
YJS_PENDING_COMPACTION_LIMIT=64
# Bound updates retained while PostgreSQL persistence is delayed.
YJS_PENDING_ROOM_UPDATE_LIMIT=256
YJS_PENDING_ROOM_BYTE_LIMIT=8388608
YJS_PENDING_PROCESS_UPDATE_LIMIT=4096
YJS_PENDING_PROCESS_BYTE_LIMIT=67108864
YJS_PENDING_UPDATE_MAX_AGE_MS=30000
