# Terminates TLS and forwards to the web image, which serves the compiled
# application and proxies the API and WebSocket to the server.
#
# Caddy obtains and renews a Let's Encrypt certificate automatically, so the
# hostname must already resolve to this host and port 80 must stay reachable.
{$CHALKBOARD_SITE_ADDRESS} {
	encode zstd gzip

	# The collaboration WebSocket needs a long idle window; Yjs connections stay
	# open for the life of an editing session.
	reverse_proxy web:8080 {
		transport http {
			read_timeout 1h
			write_timeout 1h
		}
	}
}
